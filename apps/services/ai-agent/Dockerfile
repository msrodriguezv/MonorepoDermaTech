# STEP 1: Usse a slim Python 3.11 image for production
FROM python:3.11-slim

# Set environment variables to prevent Python from writing .pyc files
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

WORKDIR /app

# Install system utilities if needed for libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy the requirements file generated by 'pip freeze > requirements.txt'
COPY apps/services/ai-agent/requirements.txt .

# Install dependencies without cache to minimize image size
RUN pip install --no-cache-dir -r requirements.txt

# Copy the service source code
COPY apps/services/ai-agent/ .

# Expose Flask default port
EXPOSE 5000

# Run the AI Agent
CMD ["python", "main.py"]