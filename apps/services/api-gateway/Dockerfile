# ==============================================================================
# MICROSERVICE: API GATEWAY
# Description: Docker container definition for the centralized API Gateway.
# Strategy: "Build-Host, Run-Container" 
# (Leverages pre-built Nx artifacts to optimize build time and image size)
# ==============================================================================

# 1. Base Image Layer
# Using Alpine Linux for a minimal security attack surface and reduced footprint.
FROM node:18-alpine

# 2. Application Directory Structure
WORKDIR /app

# 3. Dependency Installation
# We copy only the 'package.json' generated by the Nx build process (pruned).
# This ensures we don't install unnecessary devDependencies in production.
COPY dist/apps/services/api-gateway/package*.json ./

# Install only production dependencies
RUN npm install --omit=dev

# 4. Application Code
# The 'main.js' bundle includes the compiled application logic and 
# any shared libraries used by the gateway.
COPY dist/apps/services/api-gateway/main.js ./

# 5. Network Exposure
# Expose port 3000 (Internal Container Port).
# This port will be mapped by the Docker orchestration layer.
EXPOSE 3000

# 6. Runtime Command
# Start the Node.js process using the bundled entry point.
CMD ["node", "main.js"]