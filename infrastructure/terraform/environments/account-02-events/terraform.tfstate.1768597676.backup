            ],
            "secondary_private_ips": [],
            "security_groups": [],
            "source_dest_check": true,
            "spot_instance_request_id": "",
            "subnet_id": "subnet-015f785847dab44ec",
            "tags": {
              "Name": "dermatech-infra-events-server"
            },
            "tags_all": {
              "Name": "dermatech-infra-events-server"
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\r\nset -e\r\n\r\n# A. INSTALL DOCKER \u0026 TOOLS\r\ndnf update -y\r\ndnf install -y docker git htop\r\nsystemctl start docker\r\nsystemctl enable docker\r\nusermod -aG docker ec2-user\r\n\r\n# B. INSTALL DOCKER COMPOSE V2\r\nmkdir -p /usr/local/lib/docker/cli-plugins\r\ncurl -SL https://github.com/docker/compose/releases/download/v2.24.0/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose\r\nchmod +x /usr/local/lib/docker/cli-plugins/docker-compose\r\n\r\n# C. SWAP MEMORY CONFIGURATION (STABILITY)\r\ndd if=/dev/zero of=/swapfile bs=128M count=32\r\nchmod 600 /swapfile\r\nmkswap /swapfile\r\nswapon /swapfile\r\necho \"/swapfile swap swap defaults 0 0\" \u003e\u003e /etc/fstab\r\n\r\n# D. MOUNT PERSISTENT DISK\r\n# Checks if the disk is unformatted, formats it, and mounts it to /data\r\nDATA_DISK=\"/dev/nvme1n1\"\r\nMOUNT_POINT=\"/data\"\r\n    \r\n# Wait for EBS attachment\r\nsleep 20 \r\n\r\nif ! blkid $DATA_DISK; then\r\n    mkfs -t xfs $DATA_DISK\r\nfi\r\nmkdir -p $MOUNT_POINT\r\nmount $DATA_DISK $MOUNT_POINT\r\necho \"$DATA_DISK $MOUNT_POINT xfs defaults,nofail 0 2\" \u003e\u003e /etc/fstab\r\n    \r\n# Create Persistent Directories Structure\r\nmkdir -p $MOUNT_POINT/kafka $MOUNT_POINT/zookeeper $MOUNT_POINT/rabbitmq\r\nmkdir -p $MOUNT_POINT/mosquitto/config $MOUNT_POINT/mosquitto/data $MOUNT_POINT/mosquitto/log\r\n    \r\n# --- CRITICAL PERMISSION FIX ---\r\n# Grants Read/Write permissions to all users (including containers) to prevent \"Permission Denied\" loops.\r\nchmod -R 777 $MOUNT_POINT\r\n\r\n# E. CONFIGURE MOSQUITTO\r\ncat \u003c\u003cMQTTCFG \u003e $MOUNT_POINT/mosquitto/config/mosquitto.conf\r\npersistence true\r\npersistence_location /mosquitto/data/\r\nlog_dest file /mosquitto/log/mosquitto.log\r\nlistener 1883\r\nallow_anonymous true\r\nlistener 9001\r\nprotocol websockets\r\nMQTTCFG\r\n\r\n# F. INJECT PUBLIC IP (RUNTIME VARIABLE)\r\nPUBLIC_IP=$(curl -s http://checkip.amazonaws.com)\r\necho \"KAFKA_PUBLIC_IP=$PUBLIC_IP\" \u003e /home/ec2-user/.env\r\n\r\n# G. CREATE DOCKER COMPOSE FILE\r\ncat \u003c\u003cCOMPOSE \u003e /home/ec2-user/docker-compose.yml\r\nversion: '3.8'\r\nservices:\r\n  zookeeper:\r\n    image: confluentinc/cp-zookeeper:7.5.0\r\n    container_name: zookeeper\r\n    environment:\r\n      ZOOKEEPER_CLIENT_PORT: 2181\r\n      ZOOKEEPER_TICK_TIME: 2000\r\n    volumes:\r\n      - $MOUNT_POINT/zookeeper:/var/lib/zookeeper/data\r\n    restart: always\r\n\r\n  kafka:\r\n    image: confluentinc/cp-kafka:7.5.0\r\n    container_name: kafka\r\n    depends_on:\r\n      - zookeeper\r\n    ports:\r\n      - \"9092:9092\"\r\n    env_file: .env\r\n    volumes:\r\n      - $MOUNT_POINT/kafka:/var/lib/kafka/data\r\n    environment:\r\n      KAFKA_BROKER_ID: 1\r\n      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181\r\n      # DOUBLE DOLLAR SIGN ($$) FOR TERRAFORM ESCAPE\r\n      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:29092,PLAINTEXT_HOST://${KAFKA_PUBLIC_IP}:9092\r\n      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT\r\n      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT\r\n      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1\r\n      KAFKA_AUTO_CREATE_TOPICS_ENABLE: \"true\"\r\n      KAFKA_HEAP_OPTS: \"-Xmx2G -Xms2G\"\r\n    restart: always\r\n\r\n  rabbitmq:\r\n    image: rabbitmq:3-management\r\n    container_name: rabbitmq\r\n    ports:\r\n      - \"5672:5672\"\r\n      - \"15672:15672\"\r\n    environment:\r\n      RABBITMQ_DEFAULT_USER: admin\r\n      RABBITMQ_DEFAULT_PASS: admin123\r\n    volumes:\r\n      - $MOUNT_POINT/rabbitmq:/var/lib/rabbitmq\r\n    restart: always\r\n\r\n  mosquitto:\r\n    image: eclipse-mosquitto\r\n    container_name: mqtt\r\n    ports:\r\n      - \"1883:1883\"\r\n      - \"9001:9001\"\r\n    volumes:\r\n      - $MOUNT_POINT/mosquitto/config:/mosquitto/config\r\n      - $MOUNT_POINT/mosquitto/data:/mosquitto/data\r\n      - $MOUNT_POINT/mosquitto/log:/mosquitto/log\r\n    restart: always\r\nCOMPOSE\r\n\r\n# H. START SERVICES\r\ncd /home/ec2-user\r\n# Re-apply permissions just in case\r\nchmod -R 777 $MOUNT_POINT\r\ndocker compose up -d\r\n    \r\necho \"SETUP COMPLETE: Services Running on Persistent Volume\"\r\n",
            "user_data_base64": null,
            "user_data_replace_on_change": true,
            "volume_tags": null,
